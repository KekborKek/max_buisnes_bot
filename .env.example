# Скопируйте в .env и заполните. Файл .env НИКОГДА не коммитится.
# Комментарии — только на отдельных строках.

# ===== MAX =====
# Токен бота (выдают организаторы)
MAX_BOT_TOKEN=
# Секрет вебхука: 5–256 символов, только A-Z a-z 0-9 _ -
# При APP_ENV=prod пустой или change-me-please не даст приложению стартовать
MAX_WEBHOOK_SECRET=change-me-please
# Публичное имя бота (без @): кнопка «Открыть календарь» запускает его мини-приложение.
# Пусто — кнопка не показывается
MAX_BOT_USERNAME=
# Публичный HTTPS-адрес сервера (для вебхука и мини-аппа)
PUBLIC_BASE_URL=https://example.com
# Корень Russian Trusted Root CA подхватывается автоматически из deploy/certs/ — обычно
# трогать не нужно. Раскомментируйте, только если хотите указать другой путь к сертификату:
# MAX_CA_BUNDLE=

# ===== Приложение =====
# dev | prod
APP_ENV=dev
# mock — тестовые данные, real — реальные интеграции
DATA_MODE=mock
# true — сохранять сырые апдейты MAX в backend/data/captured_updates
CAPTURE_UPDATES=false
# Принимать заголовок X-Max-Init-Data: dev без проверки подписи.
# Только разработка: для мини-аппа вне MAX поставьте true. В проде всегда false
ALLOW_DEV_INITDATA=false

# ===== Календарь =====
# user_id MAX через запятую, кому доступна /demo_remind. Пусто — админов нет
ADMIN_IDS=
# Ссылки «Написать нам» и на политику обработки данных. Пусто — кнопка и строка скрыты
SUPPORT_URL=
PRIVACY_URL=
# Фоновый цикл напоминаний (раз в минуту). false — выключить
SCHEDULER_ENABLED=true
# Справочники аналитика, имена файлов внутри CONTENT_DIR. Менять обычно не нужно
# OBLIGATIONS_FILE=obligations.yaml
# WORKDAYS_FILE=workdays.yaml
# NDS_FILE=nds.yaml

# ===== Порты на вашей машине (разные для разных worktree) =====
API_PORT=8000
MINIAPP_PORT=8080
VITE_PORT=5173

# ===== Только для сервера: docker compose --profile prod =====
DOMAIN=example.com
