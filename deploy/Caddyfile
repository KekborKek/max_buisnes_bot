{$DOMAIN} {
	encode gzip
	handle /webhook/* {
		reverse_proxy backend:8000
	}
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}
	# Панель с API и схема — иначе уходят на miniapp вместе со всем остальным
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy miniapp:80
	}
}
